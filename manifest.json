{
  "manifest_version": 3,
  "name": "Study Mode — YouTube for learning",
  "description": "Keep learning videos in view. Cover distracting YouTube recommendations with topic-aware Jev decisions.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.typesafe.ai/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Study Mode", "default_popup": "panel.html", "default_icon": {"16":"icons/16.png","32":"icons/32.png","128":"icons/128.png"}},
  "icons": {"16":"icons/16.png","32":"icons/32.png","128":"icons/128.png"},
  "side_panel": {"default_path": "sidebar.html"},
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
